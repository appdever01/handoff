RAILWAY_DOCKERFILE_PATH=deploy/railway/Dockerfile
RAILWAY_RUN_UID=0
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=600
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
NODE_ENV=production
HANDOFF_RELEASE_STAGE=preview
HANDOFF_SANDBOX=0
TESTNET_PAYMENTS=0
MAINNET_PAYMENTS=0
DATA_DIR=/data
PORT=4003
LISTEN_HOST=::
PREVIEW_PROVIDER=cloudinary
APP_ORIGIN=https://your-frontend.vercel.app
CLAMAV_HOST=${{scanner.RAILWAY_PRIVATE_DOMAIN}}
CLAMAV_PORT=3310
CLOUDINARY_CLOUD_NAME=replace-in-railway
CLOUDINARY_API_KEY=replace-in-railway
CLOUDINARY_API_SECRET=replace-in-railway
