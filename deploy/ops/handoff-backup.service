[Unit]
Description=Handoff encrypted offsite backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HANDOFF_OPS_ENV=/etc/handoff/ops.env
ExecStart=/opt/handoff/backend/deploy/ops/handoff-ops.sh backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
