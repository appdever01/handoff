COMPOSE_PROJECT_NAME=REPLACE_WITH_ACTUAL_DEPLOYED_PROJECT
COMPOSE_FILE=/opt/handoff/backend/deploy/compose.yaml
COMPOSE_ENV_FILE=/etc/handoff/release.env
HANDOFF_DATA_DIR=/var/lib/handoff/data
API_SERVICE=api
STATE_DIR=/var/lib/handoff-backup
STAGING_DIR=/var/lib/handoff-backup/staging
DATA_UID=1000
DATA_GID=1000
RESTIC_REPOSITORY=s3:https://YOUR-S3-ENDPOINT/YOUR-BUCKET/handoff
RESTIC_PASSWORD_FILE=/etc/handoff/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
BACKUP_TAG=handoff-production-HOSTNAME
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
MAX_BACKUP_AGE_HOURS=30
MIN_FREE_GB=5
READINESS_URL=http://127.0.0.1:8080/api/ready
