{
  "name": "@handoff/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2",
    "format": "prettier --write src index.html tsconfig.json vite.config.ts package.json",
    "format:check": "prettier --check src index.html tsconfig.json vite.config.ts package.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@handoff/contracts": "file:vendor/handoff-contracts-0.3.1.tgz",
    "@nimiq/mini-app-sdk": "0.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
